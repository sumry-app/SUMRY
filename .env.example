# SUMRY environment variables
# Copy this file to .env and fill in the values. Vite only exposes variables
# prefixed with VITE_, and it inlines them into the client bundle at build
# time - changing a value requires a rebuild, not just a restart.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
# Find it under Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=

# Supabase anon/public key from the same page. Safe to ship in the frontend;
# Row Level Security policies, not key secrecy, protect the data. Never put the
# service_role key here.
VITE_SUPABASE_ANON_KEY=

# Base path the site is served from. Leave as / for Cloudflare Pages, Vercel,
# other hosts and local development. Use /SUMRY/ only for GitHub Pages.
VITE_BASE_PATH=/

# Demo mode. When true, the app renders the real interface against a generated
# sample caseload instead of Supabase, for preview deployments and for showing
# the product to someone who has no account. Set it on the preview environment
# only - a production build that lands in demo mode shows sample students and
# saves nothing. It can also be turned on per-visit with ?demo=1.
VITE_DEMO_MODE=false
